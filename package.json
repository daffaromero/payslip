    "@prisma/adapter-libsql": "^7.5.0",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@whiskeysockets/baileys": "^7.0.0-rc.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "geist": "^1.7.0",
    "hono": "^4.7.11",
    "jose": "^6.2.2",
    "lucide-react": "^0.577.0",
    "next": "16.2.1",
    "node-cron": "^3.0.3",
    "nodemailer": "^8.0.4",
    "puppeteer": "^24.40.0",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.72.0",
    "resend": "^6.9.4",
    "shadcn": "^4.1.0",
